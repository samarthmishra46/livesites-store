# Copy to .env.local (or .env) and fill in. Never commit real keys.

# Which assistant powers the floating card: "elevenlabs" (live voice agent) or "mock" (offline UI demo).
NEXT_PUBLIC_ASSISTANT_PROVIDER=elevenlabs
# Show the measured reply latency on the card's status pill (1 = on).
NEXT_PUBLIC_AGENT_DEBUG=1

# OpenAI — the agent's brain. Called only from our server (/api/agent/llm).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional: OpenAI-compatible base URL (proxy, Azure, local test server). Defaults to https://api.openai.com/v1.
OPENAI_BASE_URL=
# Only for reasoning models (e.g. gpt-5 family): keep it as low as the model allows for latency.
OPENAI_REASONING_EFFORT=

# ElevenLabs — listening, turn-taking and voice. Paid plan required.
ELEVENLABS_API_KEY=
# Filled in after the first `` (it prints them).
ELEVENLABS_AGENT_ID=
ELEVENLABS_LLM_SECRET_ID=
# Optional: a multilingual voice from your ElevenLabs voice library.
ELEVENLABS_VOICE_ID=

# Shared secret ElevenLabs sends to our LLM endpoint. Any long random string, e.g. `openssl rand -hex 32`.
AGENT_LLM_SECRET=
# Public https URL of this app that ElevenLabs can reach (a tunnel in development, e.g. cloudflared/ngrok).
AGENT_PUBLIC_URL=

# LiveAvatar (HeyGen) — the live lip-synced face. Voice, prompt and tools stay with the ElevenLabs agent.
# Switch NEXT_PUBLIC_ASSISTANT_PROVIDER to "liveavatar" once the key below is set.
LIVEAVATAR_API_KEY=
# Amina in Blue Suit (Portrait). `npm run avatar:setup -- --list` shows all stock avatars.
LIVEAVATAR_AVATAR_ID=334c4101-4c2d-4aa4-9c4e-342867842608
# Filled in by `npm run avatar:setup` (stores the ElevenLabs key in LiveAvatar's vault).
LIVEAVATAR_SECRET_ID=
# 1 = free sandbox sessions for testing (Wayne avatar, ~1 minute, no credits). 0 = the real avatar.
LIVEAVATAR_SANDBOX=1
