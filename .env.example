# Copy to .env.local (or .env) and fill in. Never commit real keys.

# Which assistant powers the floating card:
# "anam" (avatar + voice), "elevenlabs" (voice only) or "mock" (offline UI demo).
NEXT_PUBLIC_ASSISTANT_PROVIDER=anam
# Show the measured reply latency on the card's status pill (1 = on).
NEXT_PUBLIC_AGENT_DEBUG=1

# OpenAI — the agent's brain. Called only from our server (/api/agent/llm).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional: OpenAI-compatible base URL (proxy, Azure, local test server). Defaults to https://api.openai.com/v1.
OPENAI_BASE_URL=
# Only for reasoning models (e.g. gpt-5 family): keep it as low as the model allows for latency.
OPENAI_REASONING_EFFORT=

# ElevenLabs — listening, turn-taking and voice. Paid plan required.
ELEVENLABS_API_KEY=
# Filled in by the first `npm run agent:sync` (it prints them).
ELEVENLABS_AGENT_ID=
ELEVENLABS_LLM_SECRET_ID=
# Optional: a voice from your ElevenLabs voice library (a 20-character id, not a UUID).
ELEVENLABS_VOICE_ID=

# Shared secret ElevenLabs sends to our LLM endpoint. Any long random string, e.g. `openssl rand -hex 32`.
AGENT_LLM_SECRET=
# Public https URL of this app that ElevenLabs can reach (a tunnel in development, e.g. cloudflared/ngrok).
AGENT_PUBLIC_URL=

# Anam — the lip-synced face. Voice, prompt and tools stay with the ElevenLabs agent.
# Key from lab.anam.ai; the avatar must be a Cara 4 one from the Lab's Avatars page.
ANAM_API_KEY=
NEXT_PUBLIC_ANAM_AVATAR_ID=
# Optional: cara-4 (default) or cara-3. Director notes only apply to cara-4.
ANAM_AVATAR_MODEL=
# Optional: "us" or "eu". Pin it to the region your ElevenLabs agent and LLM run in to
# save a hop per turn; leave empty for Anam's automatic geographic routing.
ANAM_REGION=
